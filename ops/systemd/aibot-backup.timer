[Unit]
Description=AiBot — مؤقّت النسخ اليوميّ المشفَّر

[Timer]
# 02:40 لا 03:00 ولا 03:30: كلاهما مشغولٌ بمهامّ مشاريع أخرى على نفس الخادم
# (`crontab -l` يُظهر howplatform و scout). نافذةٌ فارغةٌ = لا تنازعَ على القرص.
OnCalendar=*-*-* 02:40:00
# ★ الخيار الذي يجعل المؤقّت صالحاً على **لابتوب**: الجهاز نائمٌ أو مطفأٌ في
#   02:40 كثيراً، ومؤقّتٌ بلا Persistent يفوّت الموعد بصمتٍ ويظنّ صاحبه أنّه
#   ينسخ كلّ ليلة. Persistent يقرأ آخر تنفيذٍ ناجح من القرص وينفّذ فور الصحو.
Persistent=true
# لا انفجارَ في الثانية نفسها مع مؤقّتاتٍ أخرى بعد صحوٍ جماعيّ.
RandomizedDelaySec=300
AccuracySec=1min

[Install]
WantedBy=timers.target
