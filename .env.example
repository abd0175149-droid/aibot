# ════════════════════════════════════════════════════════════
# AiBot — نموذج البيئة. انسخه إلى .env على الخادم واملأه باليد.
# لا يدخل أيّ سرٍّ حقيقيّ إلى git أبداً.
# ════════════════════════════════════════════════════════════
NODE_ENV=production
PUBLIC_URL=https://aibot.masaros.net

# ── المنافذ (مُتحقَّقٌ أنّها حرّة 2026-09-21) ──
# ⚠️ لا تستعمل 4080/4081 (BTEC) ولا 4090/4091 (grade.sbs) ولا 6384 (btec_redis)
WEB_PORT=3070
API_PORT=4100
DB_PORT=5437
REDIS_PORT=6385

# ── الوكيل ──
# ★ **بدونه `req.ip` = بوّابةُ جسر دوكر لكلّ زائر.**
#   المنفذُ منشورٌ على 127.0.0.1 وحده فلا يصله إلّا النفق، لكنّ النفق يصل
#   الحاويةَ **عبر الجسر**، فقرينُ الاتّصال هو بوّابةُ الجسر لا الحلقةُ
#   المحلّيّة — و`trustProxy: '127.0.0.1'` لا يُطابقها فتُهمَل
#   `X-Forwarded-For`. والنتيجتان: كلُّ صفوف `audit_log.ip` و`sessions.ip`
#   قيمةٌ واحدة (فلا تحقيقَ في حادثةٍ ممكن)، وحدُّ ١٠/دقيقة لكلّ IP يُعطّل
#   نفسَه — فيصير إحصاءُ البريد في `/auth/login` بلا سقفٍ لكلّ عنوان.
#
# ⚠️ والقيمةُ **خاصّةٌ بهذا الخادم** ويُعيد دوكر تعيينَها إن حُذفت الشبكة
#    وأُنشئت. اقرأها على الخادم ولا تنسخها من هنا:
#      docker network inspect "$(docker compose config --format json | jq -r .name)_default" #        --format '{{(index .IPAM.Config 0).Subnet}}'
#    ثمّ تحقّق من أنّها سرت: `docker compose logs api --tail 20` يُظهر
#    `"ip":"<عنوانُ زائرٍ حقيقيّ>"` لا `"ip":"192.168.240.1"`.
#
# ⚠️ ولا يُجعَل مفتاحاً إلزاميّاً في `deploy.sh`: له افتراضٌ عاملٌ
#    (`127.0.0.1`)، وجعلُ الاختياريِّ إلزاميّاً يحوّل غيابَه إلى نشرةٍ مرفوضة.
TRUST_PROXY=127.0.0.1,192.168.240.0/20

# ── القاعدة ──
# مالك القاعدة — للترحيلات والنسخ الاحتياطيّ وحدها
DB_USER=aibot
DB_PASSWORD=
DB_NAME=aibot

# 🔴 دور التطبيق. المالك سوبريوزر **يتجاوز RLS**، فلو اتّصل التطبيق به
#    لصارت سياسات العزل زينةً. deploy.sh يضبط كلمة سرّ هذا الدور آليّاً.
APP_DB_USER=aibot_app
APP_DB_PASSWORD=

# ── الأسرار: ولّدها بـ openssl rand -base64 32 ──
JWT_SECRET=
# 🔑 أخطر سرٍّ في المنصّة: به تُفكّ توكنات واتساب لكلّ عملائك.
#    انسخه في مدير كلمات سرٍّ خارج الخادم قبل أوّل عميل. فقدانه لا يُسترجَع.
MASTER_KEY=
MASTER_KEY_VERSION=1
# أثناء تدوير المفتاح فقط: أبقِ القديم حتّى تنتهي مهمّة إعادة التشفير
# ★★ مفاتيحُ الإصدارات السابقة — تُملأ **أثناء التدوير وحده**.
#
#    الإجراء: ① ولّد مفتاحاً جديداً، ② انقل الحاليَّ إلى `MASTER_KEY_V<الإصدار
#    الحاليّ>`، ③ ضع الجديدَ في `MASTER_KEY` وارفع `MASTER_KEY_VERSION`،
#    ④ أعِد التشفير، ⑤ ثمّ — وبعد التحقّق وحده — احذف المفتاحَ القديم.
#
# ⚠️ ولا تترك `MASTER_KEY_V<n>` مضبوطاً على **نفس** رقم `MASTER_KEY_VERSION`:
#    `loadKeys` يُسجّل المفتاحَ الرئيس أوّلاً ثمّ يمسح هذه المتغيّرات، فمفتاحٌ
#    بنفس الرقم **يطمس الرئيس** — فيُشفَّر الجديدُ بالمفتاح القديم بصمت.
MASTER_KEY_V1=
MASTER_KEY_V2=
MASTER_KEY_V3=

# ── الإشعارات: ثابتان. تغييرهما يُبطل كلّ الاشتراكات القائمة بصمت ──
# web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── الذكاء (Google) ──
PLATFORM_AI_KEY=
# ⚠️ تغيير نموذج التضمين = إعادة تضمينٍ كاملة لا ترقيةً تدريجيّة.
#    خلط نموذجَين في فهرسٍ واحد لا يُنتج خطأً — يُنتج ترتيباً فاسداً بصمت.
EMBED_MODEL=gemini-embedding-001
CHAT_MODEL=gemini-2.5-flash

# ★★ حجمُ بِركة القاعدة — **ثابتٌ معماريّ لا ضبطُ أداء.**
#    «لا نداءَ شبكةٍ داخل معاملة» وتقسيمُ عامل الردّ إلى ثلاثة أطوارٍ مبنيّان
#    على أنّ البِركة عشرةٌ وتزامنَ الوارد عشرة. وخفضُه يُنتج `timeout` عند طلب
#    اتّصالٍ في موضعٍ لا علاقةَ له بالسبب. لا تخفضه بلا مراجعة ذلك الحساب.
PG_POOL_MAX=10

# مهلةُ نبضةِ ريدِس في فحص الصحّة العميق (مِلّي ثانية).
REDIS_PING_TIMEOUT_MS=2000
