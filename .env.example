# ════════════════════════════════════════════════════════════
# AiBot — نموذج البيئة. انسخه إلى .env على الخادم واملأه باليد.
# لا يدخل أيّ سرٍّ حقيقيّ إلى git أبداً.
# ════════════════════════════════════════════════════════════
NODE_ENV=production
PUBLIC_URL=https://aibot.masaros.net

# ── المنافذ (مُتحقَّقٌ أنّها حرّة 2026-09-21) ──
# ⚠️ لا تستعمل 4080/4081 (BTEC) ولا 4090/4091 (grade.sbs) ولا 6384 (btec_redis)
WEB_PORT=3070
API_PORT=4100
DB_PORT=5437
REDIS_PORT=6385

# ── القاعدة ──
# مالك القاعدة — للترحيلات والنسخ الاحتياطيّ وحدها
DB_USER=aibot
DB_PASSWORD=
DB_NAME=aibot

# 🔴 دور التطبيق. المالك سوبريوزر **يتجاوز RLS**، فلو اتّصل التطبيق به
#    لصارت سياسات العزل زينةً. deploy.sh يضبط كلمة سرّ هذا الدور آليّاً.
APP_DB_USER=aibot_app
APP_DB_PASSWORD=

# ── الأسرار: ولّدها بـ openssl rand -base64 32 ──
JWT_SECRET=
# 🔑 أخطر سرٍّ في المنصّة: به تُفكّ توكنات واتساب لكلّ عملائك.
#    انسخه في مدير كلمات سرٍّ خارج الخادم قبل أوّل عميل. فقدانه لا يُسترجَع.
MASTER_KEY=
MASTER_KEY_VERSION=1
# أثناء تدوير المفتاح فقط: أبقِ القديم حتّى تنتهي مهمّة إعادة التشفير
# MASTER_KEY_V1=

# ── الإشعارات: ثابتان. تغييرهما يُبطل كلّ الاشتراكات القائمة بصمت ──
# web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── الذكاء (Google) ──
PLATFORM_AI_KEY=
# ⚠️ تغيير نموذج التضمين = إعادة تضمينٍ كاملة لا ترقيةً تدريجيّة.
#    خلط نموذجَين في فهرسٍ واحد لا يُنتج خطأً — يُنتج ترتيباً فاسداً بصمت.
EMBED_MODEL=gemini-embedding-001
CHAT_MODEL=gemini-2.5-flash
